# URL base de la API. En local se deja así: Vite redirige /api a http://localhost:8000
VITE_API_URL=/api/v1

# OAuth Client ID de Google (el mismo que GOOGLE_CLIENT_ID del backend)
VITE_GOOGLE_CLIENT_ID=

# Selector de Drive de la biblioteca (Google Cloud: clave de API y número del proyecto)
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
