# Copia este fichero a .env y ajusta los valores (nunca subas .env a Git)

# Postgres (contenedor db)
POSTGRES_USER=apptagaste
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=apptagaste

# API: el host "db" es el nombre del servicio en docker-compose
DATABASE_URL=postgresql+psycopg://apptagaste:cambia_esta_password@db:5432/apptagaste
ENVIRONMENT=development

# Autenticación
# Clave para firmar los tokens. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción es obligatoria (la app no arranca con la de desarrollo)
SECRET_KEY=
# OAuth Client ID de Google (ver README, "Autenticación con Google")
GOOGLE_CLIENT_ID=
